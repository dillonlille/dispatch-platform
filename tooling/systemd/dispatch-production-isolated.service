# Install as /etc/systemd/system/dispatch-production.service during the host cutover.
[Unit]
Description=Dispatch Production platform (isolated runtime)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dispatch-runtime
Group=dispatch-runtime
StateDirectory=dispatch-production
StateDirectoryMode=0700
EnvironmentFile=/etc/dispatch-production/platform.env
EnvironmentFile=/etc/dispatch-production/deployment.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Root executes only this root-owned copier and verifier, never the application.
# The root-owned deployment.env sets DISPATCH_RUNTIME_SOURCE to the updater's live directory.
ExecStartPre=+/usr/bin/python3 /usr/local/libexec/dispatch-runtime/prepare-isolated-runtime.py --source ${DISPATCH_RUNTIME_SOURCE}
ExecStart=/usr/bin/env DISPATCH_STATE_ROOT=/var/lib/dispatch-production DISPATCH_ARTIFACT_ROOT=/opt/dispatch-production/current DISPATCH_BWRAP_EXECUTABLE=/usr/local/libexec/dispatch-runtime/bwrap PATH=/usr/bin:/bin /opt/dispatch-production/current/services/rust/dispatch-backend serve
WorkingDirectory=/opt/dispatch-production
Restart=on-failure
RestartSec=5
# Under memory pressure the kernel kills the biggest process, which during a collection is
# Production's own browser. Only that collection then fails and retries; Production keeps
# serving instead of stopping and restarting.
OOMPolicy=continue
TimeoutStopSec=45
KillMode=mixed
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths=/var/lib/dispatch-production
# The trusted setuid bubblewrap launcher needs privilege transition and namespaces.
# Do not enable NoNewPrivileges, PrivateUsers or RestrictNamespaces here.
MemoryHigh=3G
MemoryMax=4G
TasksMax=1024
LimitNOFILE=16384
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
