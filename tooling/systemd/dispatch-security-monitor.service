[Unit]
Description=Dispatch security event monitor
After=dispatch-production.service

[Service]
Type=simple
User=dispatch-monitor
Group=dispatch-monitor
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/dispatch-production/security-monitor.env
ExecStart=/usr/bin/python3 /usr/local/libexec/dispatch-runtime/security-monitor.py --journal --mail-alerts
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=16
UMask=0077

[Install]
WantedBy=multi-user.target
