#!/usr/bin/env -S node --no-warnings
'use strict';

process.umask(0o077);
const fs = require('node:fs');
const path = require('node:path');
const { execute } = require('../src/collector');
const { runWorker } = require('../src/worker');

const root = path.join(__dirname, ".fixture-runtime");
const fixtures = path.join(__dirname, "./fixtures");
runWorker({
  executeRequest: (request, { signal }) => execute(request, {
    database: path.join(root, 'cdf.sqlite3'),
    artifactRoot: path.join(root, 'artifacts'),
    stagingRoot: path.join(root, '.staging'),
    fetchArtifacts: async current => ({
      csvBytes: fs.readFileSync(path.join(fixtures, `${current.input.week}.csv`)),
      providerBytes: fs.readFileSync(path.join(fixtures, `${current.input.week}-providers.json`)),
    }),
    now: () => new Date('2026-08-29T12:00:00.000Z'),
    signal,
  }),
});
