#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
node --no-warnings - <<'NODE'
'use strict';
process.umask(0o077);
const fs = require('node:fs');
const { authenticationState } = require('./src/collector');
const { CdfStore } = require('./src/store');
const { DATABASE, ARTIFACT_ROOT, STAGING_ROOT } = require('./src/paths');

(async () => {
  const authentication = await authenticationState(process.env.DISPATCH_CDF_AUTH_PROFILE || 'amazon-operations');
  const collection = ['configured', 'ready', 'authenticating'].includes(authentication) ? 'ready' : authentication;
  if (!fs.existsSync(DATABASE)) {
    console.log(JSON.stringify({
      ok: true,
      status: 'not_initialized',
      runtime: 'ready',
      storage: 'missing',
      authenticationState: authentication,
      collection,
    }));
    return;
  }
  const store = new CdfStore(DATABASE, { artifactRoot: ARTIFACT_ROOT, stagingRoot: STAGING_ROOT, readOnly: true });
  try {
    const health = store.health();
    const ready = health.ready && collection === 'ready';
    console.log(JSON.stringify({
      ok: ready,
      status: ready ? 'verified' : health.ready ? 'blocked' : 'degraded',
      runtime: 'ready',
      storage: health.ready ? 'verified' : 'degraded',
      authenticationState: authentication,
      collection,
      activeWeeks: health.activeWeeks,
      failedWeeks: health.failedWeeks,
      candidateFree: health.candidateFree,
    }));
    if (!ready) process.exitCode = 1;
  } finally { store.close(); }
})().catch(() => {
  console.log(JSON.stringify({
    ok: false,
    status: 'unavailable',
    runtime: 'ready',
    storage: fs.existsSync(DATABASE) ? 'unavailable' : 'missing',
    authenticationState: 'broker_unavailable',
    collection: 'broker_unavailable',
  }));
  process.exitCode = 1;
});
NODE
