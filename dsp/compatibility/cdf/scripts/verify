#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
PROJECT_ROOT="$(cd "$ROOT/../../.." && pwd -P)"
"$ROOT/tooling/build" >/dev/null
"$ROOT/tooling/test"
node --no-warnings - "$ROOT" "$PROJECT_ROOT" <<'NODE'
'use strict';
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const root = process.argv[2];
const projectRoot = process.argv[3];
const { validateSpec } = require(path.join(projectRoot, 'runtime/collection-manager/src/validation'));
const { validateCollectionSchedule } = require(path.join(projectRoot, 'runtime/collection-manager/src/targeting'));
const { StandardCollectionService } = require(path.join(projectRoot, 'runtime/collection-manager/src/standard-collections'));
const { CollectionManager } = require(path.join(projectRoot, 'runtime/collection-manager/src/manager'));
const { cronMatches } = require(path.join(projectRoot, 'runtime/collection-manager/src/cron'));
const { CollectionStore } = require(path.join(projectRoot, 'runtime/collection-manager/src/store'));
const { defaultPaths } = require(path.join(projectRoot, 'runtime/collection-manager/src/paths'));

(async () => {
  const packageValue = JSON.parse(fs.readFileSync(path.join(root, 'package.json'), 'utf8'));
  const raw = fs.readFileSync(path.join(root, 'config/collection-manager.json'), 'utf8')
    .replaceAll('${DISPATCH_PROJECT_ROOT}', projectRoot);
  const specification = JSON.parse(raw);
  const weeklySchedule = JSON.parse(fs.readFileSync(path.join(root, 'config/weekly-collection-schedule.json'), 'utf8'));
  validateSpec(specification);
  validateCollectionSchedule(weeklySchedule);
  if (specification.sources[0].enabled !== true || specification.plans.some(plan => plan.enabled !== true)) {
    throw new Error('manual_registration_not_enabled');
  }
  if (weeklySchedule.enabled !== false || weeklySchedule.request.selector.kind !== 'latest-complete'
      || weeklySchedule.schedule.type !== 'polling-window'
      || weeklySchedule.schedule.intervalSeconds !== 900
      || weeklySchedule.schedule.windowSeconds !== 86_400
      || weeklySchedule.schedule.retryErrors.join(',') !== 'week_unavailable') throw new Error('unsafe_weekly_schedule');
  if (!cronMatches(weeklySchedule.schedule.expression, weeklySchedule.schedule.timezone, new Date('2026-08-25T22:00:00.000Z'))
      || cronMatches(weeklySchedule.schedule.expression, weeklySchedule.schedule.timezone, new Date('2026-08-25T21:59:00.000Z'))) {
    throw new Error('weekly_schedule_cron_failed');
  }
  if (packageValue.version !== specification.collectors[0].version) throw new Error('version_mismatch');
  const collectMethod = specification.collectors[0].methods['cdf.week.collect'];
  const healthMethod = specification.collectors[0].methods['collector.health'];
  if (collectMethod.maxAttempts !== 1 || collectMethod.backoffSeconds.length !== 0
      || collectMethod.concurrencyKeys.join(',') !== 'auth:{authProfile},publish:cdf'
      || healthMethod.concurrencyKeys.join(',') !== 'publish:cdf') {
    throw new Error('unsafe_manual_collection_policy');
  }
  const fixtureRoot = fs.mkdtempSync(path.join(os.tmpdir(), 'dispatch-cdf-spec-'));
  fs.chmodSync(fixtureRoot, 0o700);
  let applied;
  try {
    const store = new CollectionStore(defaultPaths({ databaseRoot: path.join(fixtureRoot, 'db'), stateRoot: path.join(fixtureRoot, 'state') }));
    try {
      const fixtureSpec = JSON.parse(JSON.stringify(specification));
      fixtureSpec.sources[0].enabled = true;
      for (const plan of fixtureSpec.plans) plan.enabled = true;
      applied = store.applySpec(fixtureSpec);
      const service = new StandardCollectionService(store);
      const exactPreview = await service.preview({
        source: 'cdf-example', scope: 'cdf', selector: { kind: 'exact-target', key: '2026-W20' }, mode: 'ensure',
      }, { instant: new Date('2026-08-29T12:00:00.000Z') });
      if (exactPreview.targetCount !== 1 || exactPreview.targets[0].key !== '2026-W20' || exactPreview.taskCount !== 2) {
        throw new Error('manual_exact_week_preview_failed');
      }
      const backfillRequest = {
        source: 'cdf-example', scope: 'cdf',
        selector: { kind: 'target-range', startKey: '2026-W20', endKey: '2026-W22' }, mode: 'ensure',
      };
      const backfillPreview = await service.preview(backfillRequest, {
        instant: new Date('2026-08-24T12:00:00.000Z'),
      });
      if (backfillPreview.targets.map(item => item.key).join(',') !== '2026-W20,2026-W21,2026-W22'
          || backfillPreview.taskCount !== 6) throw new Error('backfill_preview_failed');
      const backfill = await service.enqueue(backfillRequest, {
        instant: new Date('2026-08-24T12:00:00.000Z'), idempotencyKey: 'cdf-backfill-W20-W22',
      });
      const duplicate = await service.enqueue(backfillRequest, {
        instant: new Date('2026-08-24T12:00:00.000Z'), idempotencyKey: 'cdf-backfill-W20-W22',
      });
      if (duplicate.id !== backfill.id || store.batch(backfill.id).runs.length !== 6) {
        throw new Error('backfill_idempotency_failed');
      }
      const registered = service.putSchedule(weeklySchedule);
      if (registered.enabled !== false || store.collectionSchedules().length !== 1) throw new Error('weekly_schedule_registration_failed');
      const opening = Date.parse('2026-08-25T22:00:00.000Z');
      store.setCollectionScheduleEnabled(registered.id, true);
      await new CollectionManager(store).scheduleCollections(opening + 7 * 60 * 60 * 1000);
      if (store.batchCount() !== 2) throw new Error('weekly_schedule_catchup_failed');
      const batch = store.batches(1)[0];
      const detail = store.batch(batch.id);
      if (detail.request.selector.kind !== 'latest-complete' || detail.runs.length !== 2
          || detail.runs.some(item => item.targetKey !== '2026-W34')
          || detail.runs.map(item => item.taskId).sort().join(',') !== 'audit,collect') {
        throw new Error('weekly_schedule_target_failed');
      }
      const collect = detail.runs.find(item => item.taskId === 'collect').run;
      const audit = detail.runs.find(item => item.taskId === 'audit').run;
      if (collect.maxAttempts !== 96 || collect.retryDeadline !== opening + 86_400_000
          || collect.retryErrors.join(',') !== 'week_unavailable'
          || audit.retryDeadline !== null || audit.retryErrors !== null) {
        throw new Error('weekly_polling_policy_failed');
      }
    } finally { store.close(); }
  } finally { fs.rmSync(fixtureRoot, { recursive: true, force: true }); }
  if (applied.collectors !== 1 || applied.sources !== 1 || applied.plans !== 3 || applied.syncs !== 0) throw new Error('manager_spec_apply_failed');
  console.log(JSON.stringify({
    ok: true, status: 'verified', version: packageValue.version, fixtureTests: 'passed',
    managerSpec: 'manual_source_and_plans_enabled_fixture_applied',
    manualPolicy: 'single_attempt_and_publication_lock_verified',
    manualCollection: 'exact_week_and_idempotent_backfill_verified',
    weeklySchedule: 'registered_disabled_tuesday_window_and_resolved_2026-W34',
  }));
})().catch(error => { process.stderr.write(`${error.message}\n`); process.exit(1); });
NODE
