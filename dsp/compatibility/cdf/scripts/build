#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
files=("$ROOT"/src/*.js "$ROOT"/tests/*.js "$ROOT"/bin/dispatch-cdf-collector "$ROOT"/tests/fixture-worker)
for file in "${files[@]}"; do node --check "$file" >/dev/null; done
printf '%s\n' '{"ok":true,"status":"built"}'
