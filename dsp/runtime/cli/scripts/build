#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for file in "$ROOT"/src/*.js "$ROOT"/src/renderers/*.js "$ROOT"/src/interactions/*.js "$ROOT"/tests/*.js "$ROOT"/../../bin/dispatch; do
  node --no-warnings --check "$file"
done
printf '%s\n' '{"ok":true,"status":"built"}'
