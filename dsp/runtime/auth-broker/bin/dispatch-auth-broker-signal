#!/usr/bin/env -S python3 -I
"""Signal only the exact recorded Dispatch Auth Broker via Linux pidfd."""

import json
import os
import signal
import sys

BROKER = os.path.realpath(os.path.join(os.path.dirname(__file__), "dispatch-auth-broker"))
BOOT_ID = "/proc/sys/kernel/random/boot_id"


def emit(ok, status, **extra):
    print(json.dumps({"ok": ok, "status": status, **extra}, separators=(",", ":")))


def start_ticks(pid):
    with open(f"/proc/{pid}/stat", "r", encoding="utf-8") as handle:
        raw = handle.read()
    close = raw.rfind(")")
    if close < 1:
        raise ValueError("invalid stat")
    fields = raw[close + 2 :].strip().split()
    value = fields[19]
    if not value.isdigit():
        raise ValueError("invalid start ticks")
    return value


def main(argv):
    os.umask(0o077)
    if len(argv) != 4:
        emit(False, "invalid_request")
        return 2
    pid_text, expected_boot, expected_ticks, signal_name = argv
    if not pid_text.isdigit() or not expected_ticks.isdigit() or signal_name not in {"TERM", "KILL"}:
        emit(False, "invalid_request")
        return 2
    pid = int(pid_text)
    if pid < 2 or len(expected_boot) != 36:
        emit(False, "invalid_request")
        return 2

    pidfd = None
    try:
        pidfd = os.pidfd_open(pid, 0)
        with open(BOOT_ID, "r", encoding="ascii") as handle:
            if handle.read().strip() != expected_boot:
                raise ProcessLookupError("boot changed")
        proc = os.stat(f"/proc/{pid}", follow_symlinks=False)
        if proc.st_uid != os.geteuid() or start_ticks(pid) != expected_ticks:
            raise ProcessLookupError("identity changed")
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            argv_bytes = [part for part in handle.read().split(b"\0") if part]
        if os.fsencode(BROKER) not in argv_bytes:
            raise ProcessLookupError("unexpected executable")
        signal.pidfd_send_signal(pidfd, signal.SIGTERM if signal_name == "TERM" else signal.SIGKILL)
        emit(True, "ok", signalled=True)
        return 0
    except (FileNotFoundError, ProcessLookupError, PermissionError, ValueError, OSError):
        emit(False, "stale_process")
        return 1
    finally:
        if pidfd is not None:
            os.close(pidfd)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
