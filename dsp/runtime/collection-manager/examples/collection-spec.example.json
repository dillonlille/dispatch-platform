{
  "schemaVersion": 1,
  "collectors": [
    {
      "id": "example",
      "version": "1.0.0",
      "description": "Replace this with a real collector",
      "command": "/absolute/path/to/owner-controlled-collector",
      "sourceSchema": {
        "type": "object",
        "properties": {
          "tenant": { "type": "string", "maxLength": 64 }
        },
        "required": ["tenant"],
        "additionalProperties": false
      },
      "methods": {
        "snapshot.full": {
          "description": "Collect a complete validated snapshot",
          "inputSchema": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "timeoutSeconds": 900,
          "maxAttempts": 3,
          "backoffSeconds": [60, 300],
          "concurrencyKeys": ["auth:{authProfile}", "publish:example"]
        }
      }
    }
  ],
  "sources": [
    {
      "id": "example-main",
      "collector": "example",
      "authProfile": "example-main",
      "config": { "tenant": "main" },
      "enabled": true
    }
  ],
  "plans": [
    {
      "id": "example-main-snapshot",
      "source": "example-main",
      "method": "snapshot.full",
      "schedule": {
        "type": "cron",
        "expression": "0 3 * * *",
        "timezone": "America/Los_Angeles"
      },
      "input": {},
      "dependsOn": [],
      "enabled": true
    }
  ]
}
