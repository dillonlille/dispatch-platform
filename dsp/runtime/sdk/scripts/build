#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for file in "$ROOT"/../../shared/contracts/src/*.js "$ROOT"/src/*.js "$ROOT"/../application/*/*.js "$ROOT"/../adapters/local/*.js "$ROOT"/examples/*.js "$ROOT"/tests/*.js; do
  node --no-warnings --check "$file"
done
node --no-warnings -e "require('$ROOT/src'); require('$ROOT/src/local'); require('$ROOT/src/public-contracts')"
printf '%s\n' '{"ok":true,"status":"built"}'
