{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  // Template for types and local checks. Generate a private deployment config with mail:configure.
  "name": "dispatch-dev-email-example",
  "main": "worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["no-reply@dev.dispatch.test"],
    },
  ],
  "vars": {
    "DISPATCH_ENVIRONMENT": "preview",
    "DISPATCH_ORIGIN": "https://dev.dispatch.test",
    "MAIL_FROM": "no-reply@dev.dispatch.test",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "secrets": {
    "required": ["MAIL_TOKEN"],
  },
}
