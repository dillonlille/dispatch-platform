#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for file in "$ROOT"/src/*.js "$ROOT"/tests/*.js "$ROOT"/examples/*.js ; do
  node --no-warnings --check "$file"
done
node --no-warnings -e "require('$ROOT/src')"
printf '%s\n' '{"ok":true,"status":"built"}'
