#!/usr/bin/env bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
for file in "$ROOT"/server/*.js "$ROOT"/public/assets/*.js "$ROOT"/tests/*.js; do
  # Check source scripts; the generated bundle is replaced by Vite below.
  [[ "$file" == "$ROOT/public/assets/frontend.js" ]] && continue
  node --no-warnings --check "$file"
done
node --no-warnings -e "require('$ROOT/server/server'); require('$ROOT/server/main')"
cd "$ROOT"
if [[ ! -x node_modules/.bin/vite ]]; then npm ci --no-audit --no-fund; fi
npx tsc --noEmit
npx vite build
printf '%s\n' '{"ok":true,"status":"built"}'
