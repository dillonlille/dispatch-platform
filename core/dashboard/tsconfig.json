{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "paths": {
      "dispatch-sdk/ui": [
        "./frontend/src/plugins/ui.ts"
      ],
      "@/*": [
        "./frontend/src/*"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*"
      ],
      "dispatch-sdk": [
        "../sdk/types/index.d.ts"
      ],
      "dispatch-sdk/*": [
        "../sdk/types/*.d.ts"
      ]
    }
  },
  "include": [
    "frontend/src",
    "vite.config.mts",
    "../plugins/*/frontend",
    "../sdk/examples/*/frontend"
  ]
}
